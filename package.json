{
  "name": "frozen-codex",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "lint:data": "tsx scripts/validate-seed.ts",
    "build:apk": "eas build -p android --profile preview",
    "export:seed": "tsx scripts/export-seed-json.ts",
    "pack": "tsx scripts/export-seed-json.ts",
    "assets": "node scripts/render-assets.cjs",
    "verify": "tsc --noEmit && tsx scripts/validate-seed.ts",
    "build:apk:local": "expo prebuild --platform android --clean && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.0",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.17",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.32",
    "expo-sharing": "~58.0.23",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.1.0",
    "lucide-react-native": "^1.77.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-webview": "^14.0.1",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/react": "~19.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
