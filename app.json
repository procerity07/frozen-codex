{
  "expo": {
    "name": "Frozen Codex",
    "slug": "frozen-codex",
    "scheme": "frozencodex",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#090E17",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#090E17"
    },
    "android": {
      "package": "com.frozencodex.companion",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#090E17"
      },
      "permissions": ["POST_NOTIFICATIONS", "SCHEDULE_EXACT_ALARM", "USE_EXACT_ALARM", "VIBRATE", "RECEIVE_BOOT_COMPLETED"]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      ["expo-notifications", { "color": "#38BDF8" }],
      "expo-web-browser",
      ["expo-splash-screen", { "image": "./assets/splash.png", "backgroundColor": "#090E17", "imageWidth": 180 }]
    ],
    "experiments": { "typedRoutes": false },
    "extra": {
      "dataManifestUrl": "https://raw.githubusercontent.com/procerity07/frozen-codex/main/data-pack/manifest.json",
      "releaseRepo": "procerity07/frozen-codex"
    }
  }
}
